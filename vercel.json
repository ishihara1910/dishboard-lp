{
    "functions": {
      "api/index.ts": {
        "includeFiles": "dist/server/**"
      }
    },
    "routes": [
      { "src": "/assets/(.*)", "dest": "/dist/client/assets/$1" },
      { "src": "/favicon.png", "dest": "/dist/client/favicon.png" },
      { "src": "/header-icon.png", "dest": "/dist/client/header-icon.png" },
      { "src": "/(.*)", "dest": "/api/index.ts" }
    ]
  }